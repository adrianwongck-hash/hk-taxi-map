{
  "name": "hk-taxi-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fetch:red-landmarks": "node scripts/fetch-red-landmarks.mjs",
    "build:red-highways": "node scripts/build-red-highway-graph.mjs",
    "build:red-highways:cache": "node scripts/build-red-highway-graph.mjs --cache-only"
  },
  "dependencies": {
    "maplibre-gl": "^6.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "osm-pbf-parser": "^2.3.0",
    "through2": "^5.0.12",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
